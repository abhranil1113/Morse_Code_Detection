# Environment Configuration for EyeSpeak AI

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=eyespeak_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/eyespeak_db
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eyespeak_db

# Security & JWT Auth
SECRET_KEY=supersecretkey_change_in_production_eyespeak_2026_jwt_token_secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Vision & Camera Configuration
CAMERA_INDEX=0
FRAME_WIDTH=640
FRAME_HEIGHT=480
TARGET_FPS=30

# Machine Learning & Blink Detection
ML_MODEL_TYPE=random_forest
MODEL_PATH=vision/artifacts/random_forest_eye_model.joblib
EAR_THRESHOLD=0.22
BLINK_SHORT_MIN_SEC=0.08
BLINK_SHORT_MAX_SEC=0.35
BLINK_LONG_MIN_SEC=0.40
BLINK_LONG_MAX_SEC=1.20
MORSE_CHAR_GAP_SEC=0.80
MORSE_WORD_GAP_SEC=2.00

# Backend WebSocket Stream Bridge
WS_BACKEND_URL=ws://127.0.0.1:8000/api/v1/ws/stream
API_BASE_URL=http://127.0.0.1:8000/api/v1
